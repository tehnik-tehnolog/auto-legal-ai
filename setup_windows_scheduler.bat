@echo off
:: ==============================================================================
:: Настройка Планировщика заданий Windows (Windows Task Scheduler)
:: Создает 4 регулярных фоновых задачи согласно регламенту RAG:
::   1. raskatof.ru (еженедельно в пн в 04:00)
::   2. автоновости (еженедельно в пн в 05:00)
::   3. судебная практика ВС РФ (ежемесячно 1-го числа в 03:00)
::   4. законы ГК/НК РФ (раз в 3 месяца в 02:00)
:: ==============================================================================

chcp 65001 >nul
cd /d "%~dp0"
echo ==============================================================================
echo [НАСТРОЙКА РАСПИСАНИЯ RAG НА WINDOWS]
echo ==============================================================================

set "BAT_PATH=%~dp0run_collectors.bat"

echo 1. Создание задачи: RAG_Collector_Cars (еженедельно, пн 04:00)...
schtasks /create /tn "RAG_Collector_Cars" /tr "\"%BAT_PATH%\" cars" /sc weekly /d MON /st 04:00 /f

echo 2. Создание задачи: RAG_Collector_News (еженедельно, пн 05:00)...
schtasks /create /tn "RAG_Collector_News" /tr "\"%BAT_PATH%\" news" /sc weekly /d MON /st 05:00 /f

echo 3. Создание задачи: RAG_Collector_VSRF (ежемесячно, 1-е число в 03:00)...
schtasks /create /tn "RAG_Collector_VSRF" /tr "\"%BAT_PATH%\" vsrf" /sc monthly /d 1 /st 03:00 /f

echo 4. Создание задачи: RAG_Collector_Laws (раз в 3 месяца, 1-е число в 02:00)...
schtasks /create /tn "RAG_Collector_Laws" /tr "\"%BAT_PATH%\" laws" /sc monthly /m JAN,APR,JUL,OCT /d 1 /st 02:00 /f

echo ==============================================================================
echo [УСПЕШНО] Все 4 задачи добавлены в Планировщик заданий Windows!
echo Вы можете посмотреть их в приложении: taskschd.msc
echo ==============================================================================
pause
